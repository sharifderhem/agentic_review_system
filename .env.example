DATABASE_PATH=./data/app.db
LOG_LEVEL=INFO

AZURE_DEVOPS_BASE_URL=https://dev.azure.com/your-organization
AZURE_DEVOPS_PAT=replace-me
AZURE_DEVOPS_API_VERSION=7.1
AZURE_DEVOPS_VERIFY_TLS=true
AZURE_DEVOPS_CA_BUNDLE=
AZURE_DEVOPS_BOT_ID=

# We choose these credentials and enter the same values in Azure Service Hooks.
WEBHOOK_USERNAME=architecture-review
WEBHOOK_PASSWORD=replace-with-a-long-random-secret
MAX_WEBHOOK_BYTES=2000000

LITELLM_BASE_URL=https://rts.ai-hub.center/api/v1
LITELLM_API_KEY=sk-replace-me
LITELLM_MODEL=openrouter/gpt-4.1-mini
LITELLM_TIMEOUT_SECONDS=120
LITELLM_MAX_OUTPUT_TOKENS=4000
REVIEW_TEMPERATURE=0

REVIEW_DRAFT_PRS=false
STATUSES_ENABLED=false
MAX_CHANGED_FILES=200
MAX_FILE_BYTES=100000
MAX_DIFF_BYTES=400000
MAX_CONTEXT_DOCUMENTS=10
MAX_CONTEXT_DOCUMENT_BYTES=100000
MAX_TOTAL_CONTEXT_BYTES=200000
AZURE_PAGE_SIZE=200
HTTP_TIMEOUT_SECONDS=30
WORKER_POLL_SECONDS=1
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_SECONDS=2
